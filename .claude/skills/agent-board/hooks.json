{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "uv run \"$CLAUDE_PROJECT_DIR/tools/board.py\" session-start", "timeout": 30 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "uv run \"$CLAUDE_PROJECT_DIR/tools/board.py\" prompt", "timeout": 15 }
        ]
      }
    ]
  }
}
